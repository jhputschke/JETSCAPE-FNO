<?xml version="1.0"?>

<jetscape>

  <!-- <enableAutomaticTaskListDetermination -->
    <!-- > false </enableAutomaticTaskListDetermination> -->

    <Random>
     <seed> 1 </seed>
    </Random>

  <nEvents> 2 </nEvents>
  <setReuseHydro> true </setReuseHydro>
  <nReuseHydro> 1 </nReuseHydro>
  <vlevel> 0 </vlevel>

  <!-- Jetscape Writer -->
  <JetScapeWriterAscii> off </JetScapeWriterAscii>

  <!-- Inital State Module  -->
  <IS>
    <grid_max_x> 15 </grid_max_x>
    <grid_max_y> 15 </grid_max_y>
    <grid_max_z> 0  </grid_max_z>
    <grid_step_x> 0.2 </grid_step_x>
    <grid_step_y> 0.2 </grid_step_y>
    <!-- <grid_step_z> 0.2 </grid_step_z> -->
      <Trento>
        <PhysicsInputs
                projectile='Au'
                target='Au'
                sqrts='200'
                cross-section='4.2'
                normalization='5.73'
            >
        </PhysicsInputs>
	<CutInputs centrality-low='0' centrality-high='10'>
        </CutInputs>
        <TransInputs
                reduced-thickness='0.063'
                fluctuation="1.05"
                nucleon-width="1.12"
                nucleon-min-dist="1.4"
            >
        </TransInputs>
        <LongiInputs
                mean-coeff="1.0"
                std-coeff="3.0"
                skew-coeff="0.0"
                skew-type="1"
                jacobian="0.8"
            >
        </LongiInputs>
      </Trento>
  </IS>

  <!-- <!-1- Hard Process -1-> -->
  <!-- <Hard> -->
  <!--   <PythiaGun> -->
  <!--     <pTHatMin>20</pTHatMin> -->
  <!--     <pTHatMax>70</pTHatMax> -->
  <!--     <eCM>200</eCM> -->
  <!--   </PythiaGun> -->
  <!-- </Hard> -->

  <!--Preequilibrium Dynamics Module -->
  <Preequilibrium>
     <tau0>0.5</tau0>
    <NullPreDynamics> </NullPreDynamics>
    <evolutionInMemory>0</evolutionInMemory>
  </Preequilibrium>

  <!-- Create liquefier -->
  <Liquefier>
      <GausLiquefier>
          <sigma_xy>0.5</sigma_xy>
          <sigma_tau>0.07</sigma_tau>
          <!-- <droplets>{{0.5, 5, 5, 0},  {160,120,120,0}}, -->
                    <!-- {{0.5, -8, -7, 0},  {240,100,100,0}}, --> 
                    <!-- {{0.5, 10, 10, 0},{150,10,10,0}}</droplets> -->
          <droplets>{{0.5, 6, 6, 0},  {10,50,50,0}}, 
                    {{0.5, -3, -3, 0},{150,0,0,0}}</droplets>
      </GausLiquefier>
      <!-- This option for if adding arb. energy to grid --> 
      <ignore_causality> 1 </ignore_causality>
  </Liquefier>

  <!-- Hydro  Module -->
  <Hydro>
    <MUSIC>
      <name>MUSIC</name>
      <beastMode>1</beastMode>
      <output_evolution_to_file>0</output_evolution_to_file>
      <output_evolution_to_memory>1</output_evolution_to_memory>
      <surface_in_memory>1</surface_in_memory>
      <Initial_time_tau_0>0.5</Initial_time_tau_0>
      <shear_viscosity_eta_over_s>0</shear_viscosity_eta_over_s>
      <freezeout_temperature>0.136</freezeout_temperature>
    </MUSIC>
    <AddLiquefier> true </AddLiquefier>
  </Hydro>

  <!-- write oput music -->
  <RootBulkWriter>
      <name> RootBulkWriter </name>
      <!-- <ofilename> root_test_nodroplets.root </ofilename> -->
      <out_file_name> bulk.root </out_file_name>
      <!-- If maxTau != 0: events are set to fixed size arrays for each event,
           with data either truncated before freezeout, or padded with zeros after
           freezeout out to maxTau 
           If maxTau == 0: use vector to include all data out to freezeout in each event
           (i.e. the output is a "ragged array" when read into numpy.
      -->
      <maxTau> 10. </maxTau> 
      <dTau> 0.1 </dTau> <!-- if = 0, defaults to MUSIC's value -->
      <maxabsX> 0 </maxabsX> <!-- if = 0, defaults to MUSIC's value -->
      <dX> 0 </dX> <!-- if 0, defaults to use MUSIC's value-->
      <out_file_name> bulk.root </out_file_name>
      <!-- use next option to true whenever adding the root bulk writer -->
      <ensure_MusicWrapper_output> 1 </ensure_MusicWrapper_output>
  </RootBulkWriter>


  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
    <!-- <take_recoil>1</take_recoil> -->
    <eCMforHadronization>200</eCMforHadronization>
  </JetHadronization>


  <!-- Particlization Module  -->
  <SoftParticlization>
    <iSS> </iSS>
  </SoftParticlization>

</jetscape>
